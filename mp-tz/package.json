{
  "name": "mp-tz",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npx next dev",
    "build": "npm run prebuild && npx next build && node -e \"const fs=require('fs'); fs.cpSync('out', '../out', {recursive:true}); if(fs.existsSync('functions')) fs.cpSync('functions', '../functions', {recursive:true});\"",
    "start": "npx next start",
    "lint": "npx next lint",
    "build:data": "node scripts/build-data.mjs",
    "lint:records": "node scripts/lint-records.mjs",
    "new:record": "node scripts/new-record.mjs",
    "import:submissions": "node scripts/import-submissions.mjs",
    "prebuild": "npm run lint:records && npm run build:data"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "react-leaflet": "^4.2.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
